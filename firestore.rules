
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para conteúdo do site (Reels, Produtos)
    // Qualquer um pode LER (para o site funcionar)
    // Apenas Admin autenticado pode ESCREVER (Painel Admin)
    match /site_content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para Analytics (Visitas)
    // Admin pode ler.
    // Qualquer um pode escrever (para incrementar contador de visitas anonimamente)
    match /analytics/{document=**} {
      allow read: if request.auth != null;
      allow write: if true; 
    }

    // Regra para Agendamentos (Bookings)
    // Qualquer um pode criar (para o formulário do site)
    // Apenas Admin autenticado pode ler, atualizar ou deletar
    match /bookings/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Regra para Financeiro e outros dados sensíveis
    // Apenas Admin autenticado pode ler e escrever
    match /financials/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regra padrão de negação para qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
